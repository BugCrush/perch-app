<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the process starts: the warm black (launch_background), the same
         colour as the Flutter intro that follows, so nothing flashes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it starts and runs: the same warm black. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/perch_ink</item>
    </style>
</resources>
